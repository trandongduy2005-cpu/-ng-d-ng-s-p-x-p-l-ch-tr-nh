{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "avatar": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "artist", "worker", "all"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ScheduleEvent": {
      "title": "ScheduleEvent",
      "description": "Individual schedule event for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["study", "routine", "group_work", "health", "artist", "personal"] },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" },
        "color": { "type": "string" },
        "completed": { "type": "boolean" },
        "targetRole": { "type": "string", "enum": ["student", "artist", "worker", "all"] }
      },
      "required": ["id", "userId", "title", "category", "date", "startTime", "endTime"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Task or todo item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "category": { "type": "string", "enum": ["study", "work", "personal", "group", "finance"] },
        "dueDate": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "priority", "completed"]
    },
    "ExpenseItem": {
      "title": "ExpenseItem",
      "description": "Income or expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["id", "userId", "title", "amount", "type", "category", "date"]
    },
    "BookingRecord": {
      "title": "BookingRecord",
      "description": "User reservation for homestay, table, or transport",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["homestay", "table", "transport"] },
        "placeName": { "type": "string" },
        "placeAddress": { "type": "string" },
        "date": { "type": "string" },
        "details": { "type": "string" },
        "guestCount": { "type": "number" },
        "contactName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "placeName", "date", "contactName", "contactPhone"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/ScheduleEvent" },
      "description": "User's schedule events"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskItem" },
      "description": "User's tasks"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseItem" },
      "description": "User's expenses"
    },
    "/users/{userId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/BookingRecord" },
      "description": "User's booking requests"
    }
  }
}
